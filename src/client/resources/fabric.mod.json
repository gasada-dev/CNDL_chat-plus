{
	"schemaVersion": 1,
	"id": "gasada_chat_responder",
	"version": "${version}",
	"name": "CNDL_chat+",
	"description": "Клиентский менеджер чата с историей, вкладками, поиском, фильтрами, автоответами, друзьями и отдельными настройками для разных серверов.",
	"authors": [
		"CNDL"
	],
	"icon": "assets/gasada_chat_responder/icon.png",
	"license": "GPL-3.0-only",
	"environment": "client",
	"entrypoints": {
		"client": [
			"ru.gasada.chatresponder.GasadaChatResponderClient"
		]
	},
	"mixins": [
		"gasada_chat_responder.mixins.json"
	],
	"depends": {
		"fabricloader": "${loader_constraint}",
		"minecraft": "${minecraft_constraint}",
		"java": "${java_constraint}",
		"fabric-api": "${fabric_api_constraint}"
	}
